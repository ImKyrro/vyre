{
  "manifest_version": 3,
  "name": "Vyre",
  "version": "1.1.8",
  "description": "Capture Roblox sessions to Vyre.",
  "permissions": [
    "cookies",
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "webNavigation",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.roblox.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vyre Companion",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
